#!/bin/sh
# Git pre-push hook: blocks a push that would publish secrets, private files or
# a Co-Authored-By trailer. Turn it on once per clone:
#     git config core.hooksPath scripts/hooks
# Skip it for one push (not recommended): git push --no-verify
for py in python3 python py; do
  if command -v "$py" >/dev/null 2>&1 && "$py" -c "import sys; sys.exit(sys.version_info < (3, 8))" 2>/dev/null; then
    exec "$py" scripts/prepush_check.py
  fi
done
echo "pre-push: Python not found, skipping the safety check." >&2
exit 0
