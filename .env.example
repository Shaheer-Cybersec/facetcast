# Facetcast local settings. Copy to .env (the dashboard's Engines panel writes keys here for you).
# Nothing here is required: with Claude Code installed, or on the manual engine, it runs with no key.

# Force an engine (otherwise the dashboard / `facetcast.py engine use` choice is used):
# claude_cli | claude | anthropic | openai | openrouter | groq | gemini | ollama | lmstudio | custom
# FACETCAST_ENGINE=claude_cli

# API keys (optional, only for the engine you use)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# GEMINI_API_KEY=
# FACETCAST_CUSTOM_BASE_URL=https://api.example.com/v1
# FACETCAST_CUSTOM_API_KEY=
# FACETCAST_CUSTOM_MODEL=

# Local model servers
# OLLAMA_HOST=http://localhost:11434
# LMSTUDIO_HOST=http://localhost:1234

# Shown on graphics and previews (optional)
# FACETCAST_AUTHOR_NAME=Jane Doe
# FACETCAST_AUTHOR_HANDLE=@janedoe
# FACETCAST_AUTHOR_HEADLINE=Photographer and builder

# Dedup with embeddings (needs requirements-embeddings.txt): on | off
# FACETCAST_EMBEDDINGS=on
# FACETCAST_PORT=8765
